{
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.7.0",
  "scripts": {
    "build": "vite-ssg build",
    "deploy": "gh-pages -d dist",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vueuse/core": "catalog:frontend",
    "dayjs": "catalog:prod",
    "nprogress": "catalog:frontend",
    "sass": "catalog:build",
    "vue": "catalog:prod",
    "vue-router": "catalog:prod"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:lint",
    "@iconify/json": "catalog:frontend",
    "@observablehq/plot": "catalog:frontend",
    "@shikijs/markdown-it": "catalog:build",
    "@shikijs/twoslash": "catalog:build",
    "@tensorflow/tfjs": "catalog:prod",
    "@types/crypto-js": "catalog:types",
    "@types/d3": "catalog:types",
    "@types/markdown-it": "catalog:types",
    "@types/markdown-it-link-attributes": "catalog:types",
    "@types/nprogress": "catalog:types",
    "@unocss/eslint-plugin": "catalog:lint",
    "@vitejs/plugin-vue": "catalog:build",
    "animate-notation": "catalog:frontend",
    "crypto-js": "catalog:prod",
    "d3": "catalog:frontend",
    "eslint": "catalog:lint",
    "gh-pages": "catalog:script",
    "jiti": "catalog:script",
    "lint-staged": "catalog:lint",
    "magic-string": "catalog:prod",
    "markdown-it": "catalog:build",
    "markdown-it-anchor": "catalog:build",
    "markdown-it-copy-code": "catalog:build",
    "markdown-it-github-alerts": "catalog:build",
    "markdown-it-link-attributes": "catalog:build",
    "markdown-it-mathjax3": "catalog:build",
    "markdown-it-tabbar": "catalog:build",
    "shiki": "catalog:build",
    "simple-git-hooks": "catalog:script",
    "typescript": "catalog:types",
    "unocss": "catalog:build",
    "unplugin-vue-components": "catalog:build",
    "unplugin-vue-markdown": "catalog:build",
    "vite": "catalog:build",
    "vite-plugin-inspect": "catalog:build",
    "vite-ssg": "catalog:build",
    "vitest": "catalog:test",
    "vue-tsc": "catalog:types"
